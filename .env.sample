# .env.sample — Docker path for vLLM + vllm-exl3 on one DGX Spark.
# Copy to .env and edit. Every value can also be overridden from the
# environment for a single run: PORT=9000 ./start_vllm.sh
# Commented-out lines show the built-in default.

# ---------------------------------------------------------------------------
# Image (./build.sh)
# ---------------------------------------------------------------------------
IMAGE="qwen38-flash-next-exl3-vllm:latest"
# Pins. The defaults are what the README's vLLM numbers were measured on.
# VLLM_VERSION="0.29.0"
# EXLLAMAV3_REF="v1.4.7"            # tag, branch or commit of turboderp-org/exllamav3
# VLLM_EXL3_REF="94c29ba25a66a7583bfa49546c783d3e70859cc6"
                                    # vcruz305/vllm-exl3; 94c29ba (2026-09-14) or newer is
                                    # required for unsharded n-gram tables and NGRAM_TABLE=disk.
                                    # "main" works too, but then the image is not reproducible.
# BASE_IMAGE="nvidia/cuda:13.0.2-devel-ubuntu24.04"
# TORCH_CUDA_ARCH_LIST="12.1"       # GB10 = sm_121
# MAX_JOBS=8                        # parallel nvcc jobs while compiling the two extensions

# ---------------------------------------------------------------------------
# Model (./download.sh)
# ---------------------------------------------------------------------------
# HF_REPO="turboderp/Qwen3.8-Flash-Next-exl3"
REVISION="3.05bpw_h5_ng5"           # ~80 GB. For 4.05 bpw: REVISION=4.05bpw_h6_ng6,
                                    # a separate MODEL_DIR, and NGRAM_TABLE=disk below.
MODEL_DIR="$HOME/models/Qwen3.8-Flash-Next-EXL3"
# HF_TOKEN=""                       # only needed for gated repos

# ---------------------------------------------------------------------------
# Serving (./start_vllm.sh). These map 1:1 onto scripts/serve_one_spark_qwen.sh,
# which is the image's entrypoint; see that script for the reasoning behind
# each default.
# ---------------------------------------------------------------------------
# CONTAINER_NAME="qwen38-exl3-vllm"
# SERVED_NAME="Qwen3.8-Flash-Next"
BIND="127.0.0.1"                    # 0.0.0.0 to serve the network; set API_KEY then
PORT=8899
# API_KEY=""                        # bearer token for the OpenAI API (vLLM's VLLM_API_KEY)
# MAX_MODEL_LEN=262144
# GPU_MEM_UTIL=0.80                 # refused above 0.85 (measured-safe ceiling)
# MAX_NUM_SEQS=4
# SPEC_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
                                    # "none" turns the draft off. Do that for workloads past
                                    # ~163,840 prompt tokens, where MTP acceptance drops to zero.
# MAMBA_SSM_DTYPE="bfloat16"        # "none" keeps the checkpoint's float32
# NGRAM_TABLE="resident"            # "disk" keeps the n-gram table memory-mapped on NVMe
# VLLM_EXL3_NGRAM_KERNEL="ext"      # or "torch"
# TOOL_CALL_PARSER="qwen3_xml"

# Appended verbatim (word-split) to `vllm serve` and to `docker run`.
# EXTRA_VLLM_ARGS=""
# EXTRA_DOCKER_ARGS=""

# Host directory mounted as /root/.cache in the container: torch.compile,
# Triton and FlashInfer caches, so the second boot skips recompilation.
# CACHE_DIR="$HOME/.cache/qwen38-exl3-vllm"

# Cold load is ~9.5 min from NVMe, ~2.5 min from page cache.
# READY_TIMEOUT_S=1800
# REQUIRE_IDLE_GPU=true             # refuse to start while another process holds the GPU

# ---------------------------------------------------------------------------
# TabbyAPI (./start_tabby.sh, ./stop_tabby.sh), the native exllamav3 path.
# It also reads MODEL_DIR, BIND, PORT, SERVED_NAME and REQUIRE_IDLE_GPU from
# above, so both servers answer on the same address under the same model name.
# Its own defaults when those are unset: BIND=0.0.0.0, PORT=18300,
# SERVED_NAME=qwen3.8-flash-next. Engine settings (context, cache, draft,
# chunk size, vision, sampling) live in docker/tabbyapi/config.yml.
# ---------------------------------------------------------------------------
# TABBY_IMAGE="qwen38-exl3-tabby:latest"
# TABBY_CONTAINER="qwen38-tabby"
# TABBY_RESTART="unless-stopped"    # docker restart policy; "no" to disable
# TABBY_CPUSET="5-9,15-19"          # the Cortex-X925 cores; "" for all 20
# TABBY_CONFIG=""                   # path to a config.yml to mount instead of the image's
# TABBY_CACHE_VOLUME="qwen38-tabby-cache"  # docker volume for kernel tuning results; "" for none
# TABBY_READY_TIMEOUT_S=600
# TABBY_EXTRA_DOCKER_ARGS=""        # appended verbatim (word-split) to `docker run`
# GB10 engine knobs, forwarded to the container only when set here:
# EXL3_DRAFT_CONFIDENCE=0.6
# EXL3_NGRAM_STREAM=1               # 0 holds the ~30 GiB n-gram table in RAM
